# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
MF_FAQ_MODEL=openai/gpt-oss-120b
MF_FAQ_REASONING_EFFORT=low
MF_FAQ_MAX_COMPLETION_TOKENS=1024
MF_FAQ_LLM_TIMEOUT_S=30
# Groq limits for openai/gpt-oss-120b (requests/min, tokens/min, requests/day, tokens/day)
MF_FAQ_LLM_RPM=30
MF_FAQ_LLM_TPM=8000
MF_FAQ_LLM_RPD=1000
MF_FAQ_LLM_TPD=200000
MF_FAQ_LLM_MAX_WAIT_S=10
MF_FAQ_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Hugging Face commit of the model; must match the workflow and the Dockerfile (deployment D2)
MF_FAQ_EMBED_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
MF_FAQ_EMBED_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "
MF_FAQ_HOLDINGS_MAX_TOKENS=400
MF_FAQ_RETRIEVAL_TOP_K=4
MF_FAQ_RETRIEVAL_THRESHOLD=0.69
MF_FAQ_HISTORY_TURNS=6
MF_FAQ_THREAD_TTL_DAYS=30
MF_FAQ_API_RATE_LIMIT=20/minute
# Daily refresh (Phase 7): server-side index pull + reload. The token is read-only
# (contents: read) on the private repo that holds the data-* releases.
MF_FAQ_INDEX_RELOAD_S=300
MF_FAQ_GITHUB_REPO=
MF_FAQ_GITHUB_TOKEN=
MF_FAQ_STALE_ALERT_DAYS=3
MF_FAQ_DEFAULT_SOURCE_ID=groww-hdfc-large-cap
MF_FAQ_LOG_LEVEL=INFO
